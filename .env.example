# Copy to .env (used by the VS Code launch configuration) and fill in.
CHECKER_NAMES=example
CHECKER_EXAMPLE_URL=https://example.com/
CHECKER_EXAMPLE_CSS_SELECTOR=h1
CHECKER_EXAMPLE_TELEGRAM_BOT_TOKEN=
CHECKER_EXAMPLE_TELEGRAM_CHAT_ID=
CHECKER_EXAMPLE_CRON_PATTERN=*/30 * * * * *
# A second checker, for a page rendered by JavaScript (needs Chromium, see README).
#CHECKER_NAMES=example,spa
#CHECKER_SPA_URL=https://example.com/app
#CHECKER_SPA_CSS_SELECTOR=#price
#CHECKER_SPA_FETCH_MODE=browser
#CHECKER_SPA_TELEGRAM_BOT_TOKEN=
#CHECKER_SPA_TELEGRAM_CHAT_ID=
#BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
STATE_FILE=data/state.json
DEBUG=checker:*
